# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Auth.js (next-auth v5)
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Widget JWT — separate secret for visitor tokens
WIDGET_JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
